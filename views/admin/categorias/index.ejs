<%- include('../../partials/header') %>

<div class="container section">
  <%- include('../../partials/admin-nav') %>

  <div class="page-heading admin-heading">
    <div>
      <p class="eyebrow">Catálogo</p>
      <h1>Categorías</h1>
    </div>
    <a class="btn btn-primary" href="/admin/categorias/nueva">Nueva categoría</a>
  </div>

  <% if (categories.length === 0) { %>
    <div class="card">
      <p class="muted">Todavía no hay categorías. Creá la primera para empezar.</p>
    </div>
  <% } else { %>
    <div class="table-wrap card">
      <table class="data-table">
        <thead>
          <tr>
            <th>Orden</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado</th>
            <th class="actions-col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% categories.forEach((category, index) => { %>
            <tr>
              <td>
                <div class="order-controls">
                  <form method="post" action="/admin/categorias/<%= category.id %>/mover">
                    <input type="hidden" name="direction" value="up">
                    <button type="submit" class="icon-button" title="Subir" <%= index === 0 ? 'disabled' : '' %>>↑</button>
                  </form>
                  <form method="post" action="/admin/categorias/<%= category.id %>/mover">
                    <input type="hidden" name="direction" value="down">
                    <button type="submit" class="icon-button" title="Bajar" <%= index === categories.length - 1 ? 'disabled' : '' %>>↓</button>
                  </form>
                </div>
              </td>
              <td><strong><%= category.nombre %></strong></td>
              <td class="muted"><%= category.descripcion || '—' %></td>
              <td>
                <span class="badge <%= category.activo ? 'badge-ok' : 'badge-muted' %>">
                  <%= category.activo ? 'Visible' : 'Oculta' %>
                </span>
              </td>
              <td>
                <div class="row-actions">
                  <a class="btn btn-small btn-ghost" href="/admin/categorias/<%= category.id %>/editar">Editar</a>
                  <form method="post" action="/admin/categorias/<%= category.id %>/visibilidad">
                    <button type="submit" class="btn btn-small btn-ghost">
                      <%= category.activo ? 'Ocultar' : 'Mostrar' %>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>
